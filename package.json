{
  "name": "kakeibo-demo-worker",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --port 8787",
    "db:migrate:local": "wrangler d1 migrations apply kakeibo_demo --local",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build:frontend": "npm --prefix frontend run build",
    "deploy:production": "wrangler deploy --env production"
  },
  "dependencies": {
    "hono": "^4.13.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "@types/node": "^24.0.0",
    "typescript": "^6.0.3",
    "vitest": "^3.2.7",
    "wrangler": "^4.131.1"
  }
}
